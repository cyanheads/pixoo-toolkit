{
  "name": "@cyanheads/pixoo-toolkit",
  "version": "0.7.3",
  "description": "TypeScript toolkit for Divoom Pixoo displays — pixel rendering, animations, and device control",
  "license": "Apache-2.0",
  "author": "Casey Hand (cyanheads)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/pixoo-toolkit.git"
  },
  "homepage": "https://github.com/cyanheads/pixoo-toolkit",
  "bugs": {
    "url": "https://github.com/cyanheads/pixoo-toolkit/issues"
  },
  "keywords": [
    "pixoo",
    "divoom",
    "led-matrix",
    "pixel-art",
    "animation",
    "iot",
    "display",
    "pixoo-64",
    "pixoo-32",
    "pixoo-16"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "bun run tsc",
    "clean": "bun run scripts/clean.ts",
    "rebuild": "bun run clean && bun run build",
    "typecheck": "bun run tsc --noEmit",
    "docs:check": "bun run scripts/check-docs-sync.ts",
    "devcheck": "bun run typecheck && bun run lint && bun run format:check && bun run docs:check",
    "check": "bun run devcheck && bun run test",
    "test:all": "bun run rebuild && bun run test",
    "prepublishOnly": "bun run devcheck && bun run test:all",
    "dev": "bun run tsc --watch",
    "demo": "bun run build && bun dist/scripts/demo.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ scripts/ tests/",
    "format": "prettier --write src/ scripts/ tests/",
    "format:check": "prettier --check src/ scripts/ tests/"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "sharp": "^0.35.3"
  }
}
